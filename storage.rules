rules_version = '2';

// Firebase Storage rules for itinerary stop attachments.
//
// This repo has no Firebase CLI config (no firebase.json), so these rules are not deployed
// automatically - paste this file's contents into Firebase Console > Storage > Rules and
// publish it there. Keep the 10MB limit below in sync with MAX_ATTACHMENT_SIZE in
// src/utils/itinerary.js if you change it.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/itineraries/{itineraryId}/{stopId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
